# Copy to .env and adjust values before running.
# Load with: export $(cat .env | xargs)  (Linux/Mac)
#            Get-Content .env | ForEach-Object { $k,$v=$_ -split '=',2; [System.Environment]::SetEnvironmentVariable($k,$v) }  (PowerShell)

# Flask
SECRET_KEY=replace-with-a-long-random-string
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# CUPS
CUPS_HOST=localhost
CUPS_PORT=631
CUPS_PRINTER=          # leave blank to use system default

# LibreOffice path (needed for DOCX conversion)
# Linux default:  /usr/bin/soffice
# macOS default:  /Applications/LibreOffice.app/Contents/MacOS/soffice
LIBREOFFICE_BIN=soffice
